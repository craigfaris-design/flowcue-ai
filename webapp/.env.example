# Only needed if the STT relay (server/) is deployed on a different
# domain/host than this webapp -- e.g. webapp on Netlify, server on Render.
# Full ws:// or wss:// URL, no trailing path (the app appends /api/stt-relay).
# VITE_STT_RELAY_URL=wss://your-server-host.example.com

# Only used if VITE_STT_RELAY_URL is unset -- same-host deployments (local
# dev, or a reverse proxy putting webapp+server on one domain) where only
# the port differs from the page's own origin. Defaults to 4000.
# VITE_STT_RELAY_PORT=4000
