DATABASE_URL=postgres://flowcue:flowcue@localhost:5432/flowcue
PORT=4000

# Get a key at https://www.assemblyai.com (free tier available). Powers
# the real-time STT relay (src/sttRelay.ts) -- without this set, the relay
# tells connecting clients it's unconfigured and the webapp falls back to
# the browser's built-in speech recognition.
ASSEMBLYAI_API_KEY=

# Set to true to serve over a self-signed HTTPS cert, matching webapp's
# HTTPS=true dev flag. Required when the webapp is accessed over HTTPS on a
# LAN address (e.g. phone testing) -- a secure page cannot open a plain
# ws:// connection to this relay (mixed content).
HTTPS=false
